{
  "@context": "https://w3id.org/openbadges/v2",
  "type": "BadgeClass",
  "id": "https://gai-observe.online/badges/{{badge.id}}",
  "name": "{{badge.name}}",
  "description": "{{badge.description}}",
  "image": "https://gai-observe.online/badges/images/{{badge.id}}.png",
  
  "criteria": {
    "type": "Criteria",
    "narrative": "{{badge.criteria}}"
  },
  
  "issuer": {
    "type": "Profile",
    "id": "https://gai-observe.online/organization",
    "name": "GAI-Observe Academy",
    "url": "https://gai-observe.online",
    "email": "badges@gai-observe.online",
    "description": "AI-powered education and certification platform"
  },
  
  "alignment": [
    {
      "type": "Alignment",
      "targetName": "{{skill.name}}",
      "targetUrl": "{{skill.url}}",
      "targetDescription": "{{skill.description}}"
    }
  ],
  
  "tags": "{{badge.tags}}",
  
  "example_assertion": {
    "@context": "https://w3id.org/openbadges/v2",
    "type": "Assertion",
    "id": "https://gai-observe.online/assertions/{{certificate.id}}",
    "badge": "https://gai-observe.online/badges/{{badge.id}}",
    
    "recipient": {
      "type": "email",
      "hashed": true,
      "salt": "{{crypto.salt}}",
      "identity": "sha256${{crypto.hashed_email}}"
    },
    
    "issuedOn": "{{issue_date}}",
    
    "verification": {
      "type": "hosted",
      "verificationUrl": "https://gai-observe.online/verify/{{certificate.id}}"
    },
    
    "evidence": [
      {
        "type": "Evidence",
        "name": "Final Exam Results",
        "description": "Scored {{score}}% on comprehensive final exam",
        "narrative": "{{evidence.narrative}}"
      }
    ]
  }
}
