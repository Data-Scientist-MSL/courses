{
  "template_id": "classic_certificate",
  "name": "Classic Certificate Template",
  "version": "1.0.0",
  "description": "Traditional elegant certificate design",
  
  "page": {
    "size": "letter",
    "orientation": "landscape",
    "dimensions": {
      "width": 11,
      "height": 8.5,
      "unit": "inches"
    },
    "dpi": 300,
    "margins": {
      "top": 0.5,
      "bottom": 0.5,
      "left": 0.5,
      "right": 0.5
    }
  },
  
  "background": {
    "type": "color",
    "color": "#FFFEF7"
  },
  
  "border": {
    "enabled": true,
    "style": "double",
    "width": 3,
    "color": "#1F2937",
    "padding": 30
  },
  
  "elements": [
    {
      "type": "logo",
      "id": "institution_logo",
      "position": {"x": 475, "y": 50},
      "size": {"width": 150, "height": 150},
      "image_url": "{{organization.logo_url}}",
      "alignment": "center"
    },
    {
      "type": "text",
      "id": "cert_title",
      "content": "Certificate of Completion",
      "position": {"x": 550, "y": 220},
      "font": {
        "family": "Playfair Display",
        "size": 52,
        "weight": "bold",
        "color": "#1F2937"
      },
      "alignment": "center",
      "text_transform": "uppercase"
    },
    {
      "type": "text",
      "id": "presented_to",
      "content": "This certifies that",
      "position": {"x": 550, "y": 290},
      "font": {
        "family": "Georgia",
        "size": 18,
        "color": "#4B5563"
      },
      "alignment": "center"
    },
    {
      "type": "dynamic_text",
      "id": "student_name",
      "field": "student.full_name",
      "position": {"x": 550, "y": 350},
      "font": {
        "family": "Great Vibes",
        "size": 60,
        "color": "#1F2937"
      },
      "alignment": "center"
    },
    {
      "type": "text",
      "id": "completion_text",
      "content": "has successfully completed",
      "position": {"x": 550, "y": 420},
      "font": {
        "family": "Georgia",
        "size": 18,
        "color": "#4B5563"
      },
      "alignment": "center"
    },
    {
      "type": "dynamic_text",
      "id": "course_title",
      "field": "course.title",
      "position": {"x": 550, "y": 470},
      "font": {
        "family": "Playfair Display",
        "size": 32,
        "weight": "bold",
        "color": "#1F2937"
      },
      "alignment": "center"
    },
    {
      "type": "dynamic_text",
      "id": "completion_date",
      "field": "completion.date",
      "position": {"x": 550, "y": 520},
      "font": {
        "family": "Georgia",
        "size": 16,
        "color": "#6B7280"
      },
      "alignment": "center",
      "format": "MMMM DD, YYYY"
    },
    {
      "type": "signature",
      "id": "instructor_sig",
      "signer_role": "instructor",
      "position": {"x": 250, "y": 580},
      "size": {"width": 200, "height": 60}
    },
    {
      "type": "dynamic_text",
      "id": "instructor_name",
      "field": "signers.instructor.name",
      "position": {"x": 350, "y": 650},
      "font": {
        "family": "Georgia",
        "size": 14,
        "color": "#1F2937"
      },
      "alignment": "center"
    },
    {
      "type": "text",
      "id": "instructor_title",
      "content": "Course Instructor",
      "position": {"x": 350, "y": 670},
      "font": {
        "family": "Georgia",
        "size": 12,
        "color": "#6B7280"
      },
      "alignment": "center"
    },
    {
      "type": "qr_code",
      "id": "verification_qr",
      "position": {"x": 950, "y": 600},
      "size": {"width": 100, "height": 100},
      "data": "https://gai-observe.online/verify/{{certificate.id}}",
      "error_correction": "M"
    },
    {
      "type": "text",
      "id": "qr_label",
      "content": "Scan to Verify",
      "position": {"x": 1000, "y": 710},
      "font": {
        "family": "Georgia",
        "size": 8,
        "color": "#6B7280"
      },
      "alignment": "center"
    },
    {
      "type": "dynamic_text",
      "id": "cert_id",
      "field": "certificate.id",
      "position": {"x": 100, "y": 670},
      "font": {
        "family": "Courier New",
        "size": 10,
        "color": "#9CA3AF"
      },
      "alignment": "left",
      "prefix": "Certificate ID: "
    }
  ]
}
