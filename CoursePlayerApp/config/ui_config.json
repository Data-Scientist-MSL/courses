{
  "theme": {
    "primary_color": "#1E88E5",
    "secondary_color": "#FFC107",
    "success_color": "#4CAF50",
    "warning_color": "#FF9800",
    "error_color": "#F44336",
    "info_color": "#2196F3",
    "background_color": "#FFFFFF",
    "secondary_background_color": "#F5F5F5",
    "text_color": "#212121",
    "secondary_text_color": "#757575",
    "dark_mode_available": true,
    "dark_mode": {
      "background_color": "#263238",
      "secondary_background_color": "#37474F",
      "text_color": "#FFFFFF",
      "secondary_text_color": "#B0BEC5"
    }
  },
  "branding": {
    "product_name": "GAI-Observe Academy",
    "company_name": "GAI-Observe",
    "logo_url": "/assets/logo.png",
    "logo_dark_url": "/assets/logo_dark.png",
    "favicon_url": "/assets/favicon.ico",
    "support_email": "support@gai-observe.online",
    "website_url": "https://gai-observe.online",
    "social_links": {
      "twitter": "https://twitter.com/gaiobserve",
      "linkedin": "https://linkedin.com/company/gai-observe",
      "github": "https://github.com/gai-observe"
    }
  },
  "navigation": {
    "sidebar_expanded_default": true,
    "show_tier_badge": true,
    "tier_badges": {
      "basic": {
        "emoji": "🔵",
        "text": "Basic",
        "color": "#90A4AE"
      },
      "intermediate": {
        "emoji": "🟢",
        "text": "Intermediate",
        "color": "#66BB6A"
      },
      "advanced": {
        "emoji": "⭐",
        "text": "Advanced",
        "color": "#FFD54F"
      }
    },
    "pages": [
      {
        "id": "home",
        "emoji": "🏠",
        "title": "Home",
        "path": "pages/00_🏠_Home.py",
        "tiers": ["basic", "intermediate", "advanced"]
      },
      {
        "id": "course_browser",
        "emoji": "📚",
        "title": "Course Browser",
        "path": "pages/01_📚_Course_Browser.py",
        "tiers": ["basic", "intermediate", "advanced"]
      },
      {
        "id": "learn",
        "emoji": "🎓",
        "title": "Learn",
        "path": "pages/02_🎓_Learn.py",
        "tiers": ["basic", "intermediate", "advanced"]
      },
      {
        "id": "labs",
        "emoji": "🧪",
        "title": "Labs",
        "path": "pages/03_🧪_Labs.py",
        "tiers": ["basic", "intermediate", "advanced"]
      },
      {
        "id": "ai_tutor",
        "emoji": "🤖",
        "title": "AI Tutor",
        "path": "pages/04_🤖_AI_Tutor.py",
        "tiers": ["intermediate", "advanced"],
        "hidden_for": ["basic"]
      },
      {
        "id": "progress",
        "emoji": "📊",
        "title": "Progress",
        "path": "pages/05_📊_Progress.py",
        "tiers": ["basic", "intermediate", "advanced"]
      },
      {
        "id": "achievements",
        "emoji": "🏆",
        "title": "Achievements",
        "path": "pages/06_🏆_Achievements.py",
        "tiers": ["intermediate", "advanced"],
        "hidden_for": ["basic"]
      },
      {
        "id": "certificates",
        "emoji": "📜",
        "title": "Certificates",
        "path": "pages/07_📜_Certificates.py",
